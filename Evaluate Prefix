#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 100

int stack[MAX];
int top = -1;

void push(int x)
{
    stack[++top] = x;
}

int pop()
{
    return stack[top--];
}

int main()
{
    char prefix[MAX];
    int i, a, b, result;

    printf("Enter prefix expression: ");
    scanf("%s", prefix);

    // Scan from right to left
    for (i = strlen(prefix) - 1; i >= 0; i--)
    {
        if (isdigit(prefix[i]))
        {
            // Convert character to integer
            push(prefix[i] - '0');
        }
        else
        {
            a = pop();
            b = pop();

            if (prefix[i] == '+')
                result = a + b;
            else if (prefix[i] == '-')
                result = a - b;
            else if (prefix[i] == '*')
                result = a * b;
            else if (prefix[i] == '/')
                result = a / b;

            push(result);
        }
    }

    printf("Result = %d\n", pop());

    return 0;
}
